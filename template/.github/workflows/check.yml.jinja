# Runs the same scripts/check as the pre-commit hook, plus gitleaks over the whole history.
name: check

on:
  push:
    branches: [main]
  pull_request:

permissions:
  contents: read

jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7.0.1
        with:
          fetch-depth: 0
{%- if include_python %}
      - uses: astral-sh/setup-uv@v10.3.2
      - run: uv sync --locked
{%- endif %}
{%- if include_typescript %}
      - uses: actions/setup-node@v7.1.0
        with:
          node-version-file: .nvmrc
      - run: npm ci
{%- endif %}
      - run: scripts/check
      - name: gitleaks (full history)
        run: |
          curl -sSfL https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/gitleaks_8.30.1_linux_x64.tar.gz | tar -xz gitleaks
          ./gitleaks git --redact --no-banner --verbose
