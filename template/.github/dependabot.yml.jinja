# Weekly pull requests to update dependencies. Each one runs the same checks.
version: 2
updates:
  - package-ecosystem: github-actions
    directory: /
    schedule:
      interval: weekly
{%- if include_python %}
  - package-ecosystem: uv
    directory: /
    schedule:
      interval: weekly
{%- endif %}
{%- if include_typescript %}
  - package-ecosystem: npm
    directory: /
    schedule:
      interval: weekly
    # Major versions of these are deliberate upgrades (the template pins
    # TypeScript, and @types/node must match the Node version you run).
    ignore:
      - dependency-name: typescript
        update-types: ["version-update:semver-major"]
      - dependency-name: "@types/node"
        update-types: ["version-update:semver-major"]
{%- endif %}
